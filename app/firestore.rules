rules_version = '2';

// Neural Observatory — Firestore Security Rules
// Read-only public access for the dashboard.
// All writes go through the Admin SDK (MCP server, migration scripts), which
// bypasses these rules. No client — authenticated or not — has write access:
// `request.auth != null` would grant write to any Google account on the
// internet, since this project has Google sign-in enabled. This is a
// single-user dashboard with no legitimate client-side writer, so deny all.

service cloud.firestore {
  match /databases/{database}/documents {

    // Skills collection — one doc per skill
    match /skills/{skillId} {
      allow read: if true;
      allow write: if false;
    }

    // Registry metadata (schema_version, last_scan, network domains)
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Usage events
    match /usage/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Evolution snapshots
    match /evolution/{snapshotId} {
      allow read: if true;
      allow write: if false;
    }

    // Gap analysis entries
    match /gaps/{gapId} {
      allow read: if true;
      allow write: if false;
    }

    // Changelogs
    match /changelogs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // Aesthetic Observatory — inspiration images.
    // Unlike the collections above, this one has a legitimate client-side
    // writer: app/observatory.html lets the signed-in owner upload, edit, and
    // archive inspirations via the client SDK. Gate on the owner's UID so only
    // that one account can write — `request.auth != null` alone would grant
    // write to any Google account on the internet.
    // Owner UID — only this account may write inspirations from the client.
    match /inspirations/{inspirationId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'l2Q28Abg39QsMiRQzH3yL2a0tN13';
    }
  }
}
