rules_version = '2';

// Aesthetic Observatory — Firebase Storage Security Rules
// Public read for gallery display. Write restricted to authenticated users.
// Images only, 10MB max per file.

service firebase.storage {
  match /b/{bucket}/o {
    match /inspirations/{inspirationId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
