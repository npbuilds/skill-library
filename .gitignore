# Claude Code: settings.json is shared (tracked); everything else local
.claude/*
!.claude/settings.json

# OS files
.DS_Store
Thumbs.db

# Temporary/backup files
*.tmp
*.bak
gha-creds-*.json
__pycache__/

# Debug and build logs
*.log
firebase-debug.log

# ── Data ──
data/backups/
# Dated diagnostic eval reports are noise; the committed baseline
# (data/health/eval_baseline.json) is the tracked artifact.
data/health/eval_retrieval_*.json
data/health/eval_structural_*.json
# Embedding cache rebuilt on registry change (see mcp-server/search_index.py)
data/skill_embeddings.npy
data/skill_embed_names.json
data/skill_embed_mtime.json
data/.embed_rebuild.lock

# ── Firebase / App ──
app/.firebase/
app/node_modules/

# ── Obsidian ──
skills/.obsidian/workspace.json
skills/.obsidian/workspaces.json
skills/.obsidian/workspace-mobile.json
exports/

# ── Generated output ──
# Version-controlled: output/visualizations/ (legacy dashboards)
# Everything else in output/ is gitignored
output/
!output/visualizations/

# ── Pre-change snapshots & local-only files ──
data/registry.json.pre-*
scripts/*.pre-phase*
*.local-untracked

# Local backup of removed Aesthetic Observatory data (not for commit)
app/_inspirations-backup/

# Retired local aggregate artifact (the live rollup is evolution_daily in Firestore)
data/evolution_daily.json

# Retired raw history. Kept ignored so existing local backups are preserved;
# no current hook, migration, or scheduled job writes or reads this file.
data/evolution.jsonl

# Dated sentinel health reports now persist to Firestore (health_reports
# collection); no longer committed. eval_baseline.json + eval_* outputs stay tracked.
data/health/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].json
